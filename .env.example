# ---- Web server ----
# Port and host the app listens on.
PORT=4173
HOST=127.0.0.1

# ---- Google Sheets (optional) ----
# Leave SHEET_ID blank to use the local JSON store in data/db.json.
# Copy the ID from https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Option A: path to a service-account key JSON file.
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Option B: paste the whole service-account JSON on one line.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option C: individual service-account fields (use \n for line breaks in the key).
# GOOGLE_SA_EMAIL=zest@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Tab names. Missing tabs are created automatically with the right headers.
SHEET_TAB_ENTRIES=Entries
SHEET_TAB_PROFILES=Profiles

# Set to 1 to force local storage even when Google Sheets is configured.
FORCE_LOCAL=0
